# Copiez ce fichier en ".env" puis remplissez-le. Ne commitez jamais ".env".

# --- IA (Gemini). Sans clé, l'application démarre en mode hors ligne (texte et mots-clés).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts

# --- Secours facultatif si Gemini est saturé
# OPENAI_API_KEY=

# --- Administration : sans ces valeurs, le tableau de bord et l'API d'administration restent fermés.
DASHBOARD_PASSWORD=
ADMIN_API_KEY=
# DRAFT_SECRET=                    # signe les brouillons de l'API ; vide = tiré au démarrage

# --- Réglages facultatifs
# APP_NAME=Yëgle
# REF_PREFIX=YGL
# LLM_MODE=offline                 # force le mode hors ligne même avec une clé
# ROUTING_MIN_CONFIDENCE=0.75      # sous ce seuil, vérification humaine
# ROUTING_REQUIRE_VERIFIED=true    # false = accepter les fiches organismes non vérifiées (démo uniquement)
